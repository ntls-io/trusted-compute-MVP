# NOTE: this was a bare `start.sh`, which git matches at ANY depth. It silently
# excluded sgx-mvp/docker/start.sh — the enclave container entrypoint that
# docker/Dockerfile COPYs — so a fresh clone could not build the image and CI
# could not lint it. Anchored to the repo root instead.
/start.sh

/site/*

test-ledger
# Local development oracle signing key generated by scripts/dev-up.sh.
# Development-only; never deployed.
/.secrets/
