# Nautilus Trusted Compute
# Copyright (C) 2026 Relational Network

# Copy to .env.local for local development:  cp .env.example .env.local
#
# Only these variables need setting. Chain configuration (program ID, cluster,
# RPC endpoint) is NOT here by design — it lives in lib/config.ts, with the
# program ID read from the committed IDL.
#
# That is deliberate rather than an omission. The wallet-signed chain claim
# carries `program` and `cluster`, and the enclave rejects any claim whose
# values differ from what was measured into its MRENCLAVE. Making them
# environment-configurable let the claim desync from the transaction Anchor
# actually sent, which surfaces as an unexplained authorisation failure.
# To target a different deployment, change the IDL.

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# Local:  docker run --name postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
#         docker exec -it postgres psql -U postgres -c "CREATE DATABASE ntls_dev;"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ntls_dev?schema=public"

# Clerk backend key — https://dashboard.clerk.com → API keys
CLERK_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NON-SECRET
# ─────────────────────────────────────────────────────────────────────────────

# Clerk frontend key. Publishable by design, but account-specific, so it still
# has to be supplied.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Base URL of the devops-acr service (VM deployment API + attestation).
# Deployment identity, so it is an environment variable rather than committed.
# Required: pool creation and every attestation preflight call it.
NEXT_PUBLIC_API_URL=

# Optional Clerk route overrides; the /sign-in and /sign-up routes already exist.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
