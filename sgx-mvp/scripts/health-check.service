# One-shot health check for the sgx-mvp enclave. Driven by health-check.timer.

[Unit]
Description=sgx-mvp enclave health check
After=enclave.service
Wants=enclave.service

[Service]
Type=oneshot
ExecStart=/opt/sgx-mvp/scripts/health-check.sh
